# LLM providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional local provider for local development only.
# It is not reachable from Render/Hugging Face unless you expose it yourself.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=openai/gpt-oss-20b
LM_STUDIO_API_KEY=lm-studio

# RAG
EMBEDDINGS_FILE=data/processed/research_embeddings.json
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=6
RETRIEVAL_K=20
MIN_SIMILARITY=0.12
MAX_HISTORY_TURNS=6
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# Generation
MAX_TOKENS=1200
TEMPERATURE=0.2
TRANSIENT_RETRIES=1
